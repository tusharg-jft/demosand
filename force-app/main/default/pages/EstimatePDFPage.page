<apex:page standardController="Estimate__c" extensions="EstimatePDFController" showHeader="false" sidebar="false">
    <style>
    
    
    .download-btn {
    display: inline-block;
    margin: 40px auto 0;
    padding: 12px 28px;
    background-color: #2b6cb0; /* Deep blue */
    color: white;
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
}

.download-btn:hover {
    background-color: #2c5282; /* Slightly darker on hover */
}

    
    
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            color: #333;
        }

        .header {
            background-color: #7b83eb;
            color: white;
            text-align: center;
            padding: 15px;
            font-size: 22px;
            font-weight: bold;
        }

        .sub-header {
            text-align: center;
            font-size: 16px;
            margin-bottom: 20px;
        }

        .section {
            padding: 15px;
        }

        .info-grid {
            width: 100%;
            margin-bottom: 20px;
        }

        .info-grid td {
            vertical-align: top;
            padding: 5px 10px;
        }

        .section-title {
            background-color: #f2f6fd;
            font-weight: bold;
            padding: 8px;
            border: 1px solid #ccc;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th {
            background-color: #dde4ff;
            font-weight: bold;
            padding: 6px;
            border: 1px solid #ccc;
            text-align: center;
        }

        td {
            border: 1px solid #ccc;
            padding: 6px;
            text-align: center;
        }

        .footer-address {
            text-align: center;
            margin-top: 30px;
            font-size: 11px;
            color: #555;
        }
    </style>

    <div class="header">ESTIMATE</div>
    <div class="sub-header">{!Estimate__c.Status__c}</div>

    <div class="section">
        <!-- Info Grid -->
        <table class="info-grid">
            <tr>
                <td width="33%">
                    <strong>Safer Air</strong><br/>
                    18283 Pasadena St, D 103<br/>
                    Lake Elsinore, California, 92530<br/><br/>
                    <strong>Vendor Estimate No:</strong>
                </td>
                <td width="33%">
                    <strong>Job Location</strong><br/>
                </td>
                <td width="33%">
                    <strong>Work Request Info</strong><br/>
                </td>
            </tr>
        </table>

        <!-- Estimate Summary -->
        <div class="section-title">Estimate Summary</div>
        <table>
            <tr>
                <th>Estimate ID</th>
                <td>{!Estimate__c.Id}</td>
                <th>Work Order</th>
                <td>{!Estimate__c.Work_Orders__c}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{!Estimate__c.Status__c}</td>
                <th>Estimate Date</th>
                <td>{!Estimate__c.Estimate_Date__c}</td>
            </tr>
        </table>

        <!-- Estimate Breakdown -->
        <div class="section-title">Estimated</div>
        <apex:repeat value="{!EstimateBreakdown}" var="section">
            <table>
                <tr>
                    <td colspan="7" class="section-title">{!section.label}</td>
                </tr>
                <apex:repeat value="{!section.fields}" var="row">
                    <tr>
                        <apex:repeat value="{!row}" var="field">
                            <apex:outputPanel rendered="{!!field.isNested}">
                                <td>
                                    <table>
                                        <apex:repeat value="{!field}" var="inner">
                                            <tr>
                                                <th>{!inner.fieldlabel}</th>
                                                <td>{!inner.value}</td>
                                            </tr>
                                        </apex:repeat>
                                    </table>
                                </td>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!field.isNested}">
                                <td>{!field.value}</td>
                            </apex:outputPanel>
                        </apex:repeat>
                    </tr>
                </apex:repeat>
            </table>
        </apex:repeat>
    </div>

 <button class="download-btn" onclick="downloadPDF()">Download</button>
            <script>
                function downloadPDF() {
                    const element = document.getElementById('pdf-content');
                    html2pdf().from(element).set({
                        margin: 0.5,
                        filename: 'Estimate.pdf',
                        image: { type: 'jpeg', quality: 0.98 },
                        html2canvas: { scale: 2 },
                        jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
                    }).save();
                }
            </script>
    <div class="footer-address">
        18283 Pasadena St, D 103, Lake Elsinore, California, 92530<br/>
        Email: mailto:service@saferair.org
    </div>
</apex:page>